# Bu dosyayı ".env" olarak kopyalayın ve gerçek değerlerle doldurun.
# Yerel geliştirmede python-dotenv tarafından otomatik olarak yüklenir.
# GitHub Actions üzerinde bu değerler yerine repo "Secrets" kullanılır.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=ornek@gmail.com
SMTP_PASSWORD=uygulama-sifresi
ALERT_EMAIL_FROM=ornek@gmail.com
ALERT_EMAIL_TO=bildirim-alacak-kisi@example.com

NEWSAPI_KEY=
