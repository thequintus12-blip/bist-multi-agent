# Bu dosyayı ".streamlit/secrets.toml" olarak kopyalayın ve gerçek değerlerle doldurun.
# secrets.toml dosyasını ASLA GitHub'a commit etmeyin (.gitignore içinde zaten hariç tutulmuştur).
# Streamlit Community Cloud kullanıyorsanız bu değerleri App Settings > Secrets bölümüne
# aynı TOML formatıyla girin; ayrı bir dosya yüklemenize gerek yoktur.

SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = "465"
SMTP_USER = "ornek@gmail.com"
SMTP_PASSWORD = "uygulama-sifresi"   # Gmail için normal şifre değil, "uygulama şifresi" kullanın
ALERT_EMAIL_FROM = "ornek@gmail.com"
ALERT_EMAIL_TO = "bildirim-alacak-kisi@example.com"

# Opsiyonel: harici bir haber API'sine geçmek isterseniz (varsayılan: ücretsiz Google News RSS)
NEWSAPI_KEY = ""

# Opsiyonel: e-posta bildirimlerinde uygulamaya link vermek için
APP_BASE_URL = "https://sizin-uygulamaniz.streamlit.app"
